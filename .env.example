# =============================================================================
# PRECISION NUTRITION ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copie este arquivo para ".env" e preencha com valores seguros antes de subir.
# NUNCA commite o arquivo ".env" no Git!
# =============================================================================

# --- Domínio e HTTPS (Caddy Reverse Proxy) ---
# Local: localhost | Produção: nutri.seudominio.com
APP_DOMAIN=localhost

# --- PostgreSQL 16 Database Configuration ---
# Porta do host em dev local: 5433 (evita colisão com Postgres nativo na 5432)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=precision_nutrition
DB_USER=precision_user
DB_PASS=change_me_strong_password

# Docker Compose PostgreSQL Credentials (usados no docker-compose.prod.yml)
POSTGRES_DB=precision_nutrition
POSTGRES_USER=precision_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5433

# --- Spring Boot Backend Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/precision_nutrition
SPRING_DATASOURCE_USERNAME=precision_user
SPRING_DATASOURCE_PASSWORD=change_me_strong_password
CORS_ALLOWED_ORIGIN=https://localhost

# --- Autenticação Fechada (JWT + Admin Bootstrap) ---
# Gere uma chave aleatória forte com no mínimo 32 caracteres (ex: openssl rand -base64 48)
JWT_SECRET=replace_with_at_least_32_char_random_secret_key
# Duração da sessão persistente em segundos (padrão: 30 dias = 2592000)
JWT_EXPIRATION_SECONDS=2592000
# Provisionamento inicial do administrador (criado automaticamente se não existir)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# --- USDA FoodData Central API ---
# Obtenha sua chave gratuita em: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# --- Copiloto Nutricional com IA (Google Gemini) ---
# Obtenha sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Next.js Frontend Configuration ---
PORT=3000
# Em Docker Compose, o SSR/Server Actions usa INTERNAL_API_URL=http://backend:8080
INTERNAL_API_URL=http://localhost:8080
# URL pública da API (local: http://localhost:8080 | produção com Caddy: https://seu-dominio)
NEXT_PUBLIC_API_URL=http://localhost:8080
